# COMRADII demo backend base URL. The Next.js proxy appends /api/<resource>.
# Leave unset until the backend URL is available.
DEMO_API_BASE_URL=

# Set to false to hide Capstone Showcase and the Five-step API demo.
NEXT_PUBLIC_SHOW_CAPSTONE=true

# Franklin chat is off unless explicitly enabled server-side for a deployment.
FRANKLIN_CHAT_ENABLED=false

# Optional AI Gateway model for Franklin. Defaults to a low-cost text model.
# AI Gateway authentication is supplied by the Vercel runtime in previews/deployments.
FRANKLIN_MODEL=google/gemini-2.5-flash-lite
